---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticle } from '../lib/db';

const slug = Astro.url.searchParams.get('article') ?? '';
const article = slug ? await getArticle(slug) : null;
const sent = Astro.url.searchParams.get('sent') === '1';
---
<BaseLayout title="Republish | Kvisl" description="Request permission to republish a Kvisl essay.">
  <main class="container page-main">
    <div class="narrow-page">
      <p class="eyebrow">Republish</p>
      <h1 class="page-title">Republish</h1>
      <p class="page-lede">
        {article
          ? <>Request permission to republish <em>{article.title}</em>.</>
          : <>Request permission to republish a <span class="notranslate" translate="no">Kvisl</span> article.</>}
      </p>

      <div class="republish-terms">
        <p>Republication requires written permission from <span class="notranslate" translate="no">Kvisl</span> before publication.</p>
        <p>Permission covers the article text only unless image rights are separately confirmed. The author, article title and <span class="notranslate" translate="no">Kvisl</span> must be credited, with a link to the original page and its canonical URL preserved online.</p>
        <p>Material edits, abridgements and translations require separate approval.</p>
      </div>

      {sent ? (
        <p class="republish-success">Request received. We will review it before any republication takes place.</p>
      ) : (
        <form class="republish-form" method="post" action="/api/republish">
          <input type="hidden" name="article_slug" value={article?.slug ?? ''} />
          <input type="hidden" name="article_title" value={article?.title ?? ''} />
          <label><span>Publication</span><input name="publication_name" required autocomplete="organization" /></label>
          <label><span>Contact name</span><input name="contact_name" autocomplete="name" /></label>
          <label><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
          <label><span>Where will it appear?</span><input name="destination" placeholder="Publication URL or edition" /></label>
          <label><span>Notes</span><textarea name="notes" rows="5" placeholder="Language, planned publication date, or other details"></textarea></label>
          <button type="submit">Request republication</button>
        </form>
      )}
    </div>
  </main>
</BaseLayout>
