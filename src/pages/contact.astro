---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Kvisl" description="Contact Kvisl.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Contact</p>
    <h1 class="page-title">Contact</h1>
    <div class="policy-copy">
      <p>Kvisl handles submissions, reprint requests, collaborations, and rights enquiries through its official channels.</p>
      <p>A public contact address will appear here when it is ready. Until then, do not send manuscripts, personal information, or payments to unofficial accounts claiming to represent Kvisl.</p>
    </div>
  </main>
</BaseLayout>
