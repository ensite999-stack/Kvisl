---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Kvisl" description="Contact Kvisl.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Contact</p>
    <h1 class="page-title">Contact</h1>
    <div class="policy-copy">
      <p>Use official <span class="notranslate" translate="no">Kvisl</span> channels for submissions, rights, republication, and collaboration enquiries.</p>
      <p>A public contact address will be added here when it is ready. Until then, do not send manuscripts, personal information, or payments to accounts that claim to represent <span class="notranslate" translate="no">Kvisl</span>.</p>
    </div>
  </main>
</BaseLayout>
