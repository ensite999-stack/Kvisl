---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleLabel from '../components/ArticleLabel.astro';
import { getPublishedArticles } from '../lib/db';

const articles = await getPublishedArticles(8);
const latest = articles[0];
const stories = articles.slice(1, 7);
---
<BaseLayout>
  <main class="home-main">
    {latest && (
      <section class="latest-feature">
        <a class="latest-image" href={'/essay/' + latest.slug} aria-label={'Read ' + latest.title}>
          {latest.cover_url
            ? <img src={latest.cover_url} alt={latest.cover_alt} loading="eager" fetchpriority="high" />
            : <img src="/icon.svg" alt="Kvisl" loading="eager" />}
        </a>
        <div class="container latest-copy">
          <ArticleLabel type={latest.article_type} category={latest.topic} />
          <h1><a href={'/essay/' + latest.slug}>{latest.title}</a></h1>
          <p class="latest-dek">{latest.dek}</p>
          <p class="latest-meta">{latest.author}</p>
        </div>
      </section>
    )}

    {stories.length > 0 && (
      <section class="container home-essays">
        <div class="section-heading">
          <h2>Essays</h2>
          <a href="/archive">View archive →</a>
        </div>
        <div class="story-grid">
          {stories.map((story) => (
            <article class="story-card">
              <a href={'/essay/' + story.slug}>
                {story.cover_url && <img src={story.cover_url} alt={story.cover_alt} loading="lazy" />}
                <ArticleLabel type={story.article_type} category={story.topic} />
                <h3>{story.title}</h3>
                <p>{story.dek}</p>
                <div class="story-meta"><span>{story.author}</span></div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="container home-archive-strip">
      <a href="/archive"><span>Archive</span><strong>View all essays</strong><span>→</span></a>
    </section>
  </main>
</BaseLayout>
