---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Donate | Kvisl" description="Support independent publishing at Kvisl.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Donate</p>
    <h1 class="page-title">Donate</h1>
    <div class="policy-copy">
      <p><span class="notranslate" translate="no">Kvisl</span> is member-run and publishes independently as a nonprofit.</p>
      <p>The formal donation channel is not open yet. <span class="notranslate" translate="no">Kvisl</span> will not ask you to send money to a personal account, cryptocurrency address, or unofficial payment link. The official option will appear on this page when it is ready.</p>
    </div>
  </main>
</BaseLayout>
