---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Donate | Kvisl" description="Support independent publishing at Kvisl.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Donate</p>
    <h1 class="page-title">Donate</h1>
    <div class="policy-copy">
      <p><span class="notranslate" translate="no">Kvisl</span> is an independent, member-run nonprofit. Donations will support editing, publishing, and the infrastructure that keeps the site available.</p>
      <p>Our donation channel is not open yet. When it is, the official option will appear here. We will never ask for donations to personal accounts, cryptocurrency addresses, or unofficial payment links.</p>
    </div>
  </main>
</BaseLayout>
