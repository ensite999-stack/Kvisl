---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Copyright | Kvisl" description="Kvisl copyright and reuse information.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Copyright</p>
    <h1 class="page-title">Copyright</h1>
    <div class="policy-copy">
      <p>Unless otherwise stated, original Kvisl writing, editorial arrangement, and visual design are protected by copyright.</p>
      <p>Reasonable quotation should preserve context and identify the author, article title, and Kvisl. Full republication, commercial use, translated publication, or large-scale redistribution requires separate permission.</p>
      <p>Third-party images and source material remain the property of their respective rights holders and are used according to the credits and licence terms shown on the relevant page.</p>
    </div>
  </main>
</BaseLayout>
