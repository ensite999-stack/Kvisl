---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLabel from '../../components/ArticleLabel.astro';
import { getArticle } from '../../lib/db';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/archive');
const article = await getArticle(slug);
if (!article) return new Response('Not found', { status: 404 });

const fmt = (value: string | null) => value
  ? new Intl.DateTimeFormat('en-GB', { year:'numeric', month:'long', day:'numeric' }).format(new Date(value))
  : '';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.dek,
  author: { '@type': 'Person', name: article.author },
  datePublished: article.published_at,
  articleSection: article.topic,
  image: article.cover_url ?? undefined,
  publisher: { '@type': 'Organization', name: 'Kvisl' }
};
---
<BaseLayout title={article.title + ' | Kvisl'} description={article.dek} image={article.cover_url} article>
  <main class="article-page">
    {article.cover_url && (
      <figure class="article-cover-wrap">
        <img class="article-cover" src={article.cover_url} alt={article.cover_alt} fetchpriority="high" />
        {article.cover_credit && <figcaption>{article.cover_credit}</figcaption>}
      </figure>
    )}

    <header class="article-head container">
      <ArticleLabel type={article.article_type} category={article.topic} />
      <h1>{article.title}</h1>
      <p class="dek">{article.dek}</p>
    </header>

    <div class="article-copy">
      <div class="article-body" set:html={article.body_html ?? ''} />
    </div>

    <footer class="article-end">
      <div class="article-end-tags" aria-label="Article classification">
        <span>{article.article_type || 'Essay'}</span>
        {article.topic && <span>{article.topic}</span>}
        {article.tags.slice(0, 10).map((tag) => <span>{tag}</span>)}
      </div>
      <p class="article-end-author">By {article.author}</p>
      {article.published_at && <time datetime={article.published_at}>{fmt(article.published_at)}</time>}
      <div class="article-end-actions">
        <button type="button" data-share-article data-title={article.title}>Share</button>
        <a class="republish-link" href={'/republish?article=' + encodeURIComponent(article.slug)}>Republish</a>
      </div>
    </footer>
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)}></script>
  </main>

  <script>
    const shareButton = document.querySelector('[data-share-article]');
    shareButton?.addEventListener('click', async () => {
      if (!(shareButton instanceof HTMLButtonElement)) return;
      const title = shareButton.dataset.title || document.title;
      try {
        if (navigator.share) {
          await navigator.share({ title, url: window.location.href });
          return;
        }
        await navigator.clipboard.writeText(window.location.href);
        shareButton.textContent = 'Copied';
        window.setTimeout(() => { shareButton.textContent = 'Share'; }, 1600);
      } catch {}
    });
  </script>
</BaseLayout>
