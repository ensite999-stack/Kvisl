---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy | Kvisl" description="Kvisl privacy information.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Privacy</p>
    <h1 class="page-title">Privacy</h1>
    <div class="policy-copy">
      <p><span class="notranslate" translate="no">Kvisl</span> collects only the information needed to operate the site and provide requested services. If you subscribe, we store the email address you submit so we can send new essays and occasional editorial notes.</p>
      <p>We do not sell subscriber lists to advertisers. Hosting and infrastructure providers may process basic access logs for security, reliability, and troubleshooting.</p>
      <p>You can unsubscribe using the link in our messages or through an official contact channel when one is available.</p>
    </div>
  </main>
</BaseLayout>
