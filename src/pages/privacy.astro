---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy | Kvisl" description="Kvisl privacy information.">
  <main class="container page-main narrow-page">
    <p class="eyebrow">Privacy</p>
    <h1 class="page-title">Privacy</h1>
    <div class="policy-copy">
      <p><span class="notranslate" translate="no">Kvisl</span> collects only the information needed to provide the service. If you subscribe, the email address you submit is stored so <span class="notranslate" translate="no">Kvisl</span> can send essays and occasional editorial notes.</p>
      <p>Subscriber lists are not sold to advertisers. Hosting and infrastructure providers may process basic access logs for security, reliability, and troubleshooting.</p>
      <p>You can stop receiving email through the unsubscribe method provided in messages or through an official <span class="notranslate" translate="no">Kvisl</span> contact channel when available.</p>
    </div>
  </main>
</BaseLayout>
