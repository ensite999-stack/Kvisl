---
interface Props {
  fallback?: string;
  label?: string;
}
const { fallback = '/', label = 'Back' } = Astro.props;
---
<button class="back-rail" type="button" data-back-rail data-fallback={fallback} aria-label={label} title={label}>
  <span class="back-rail-chevron" aria-hidden="true"></span>
</button>

<script>
  const button = document.querySelector('[data-back-rail]');

  button?.addEventListener('click', () => {
    if (!(button instanceof HTMLButtonElement)) return;
    const fallback = button.dataset.fallback || '/';

    if (window.history.length > 1) {
      window.history.back();
      return;
    }

    window.location.href = fallback;
  });
</script>
