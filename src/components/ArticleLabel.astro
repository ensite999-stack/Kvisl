---
interface Props {
  type?: string | null;
  category?: string | null;
  class?: string;
}
const { type = 'Essay', category = 'General', class: className = '' } = Astro.props;
---
<div class:list={['article-label', className]}>
  <svg viewBox="0 0 18 22" aria-hidden="true"><path d="M3 2.5h12v17l-6-4-6 4z" /></svg>
  <span>{type || 'Essay'}</span>
  {category && <><span class="article-label-separator">/</span><span>{category}</span></>}
</div>
