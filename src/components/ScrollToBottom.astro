<!-- Kvisl page-jump control -->
<button class="scroll-jump" type="button" data-scroll-jump aria-label="Scroll to bottom" title="Scroll to bottom">
  <svg class="scroll-jump-icon" viewBox="0 0 24 64" aria-hidden="true">
    <path d="M12 4v48" />
    <path d="M5.5 45.5 12 52l6.5-6.5" />
  </svg>
</button>

<script>
  const button = document.querySelector('[data-scroll-jump]');

  if (button instanceof HTMLButtonElement) {
    const sync = () => {
      const root = document.documentElement;
      const remaining = root.scrollHeight - window.scrollY - window.innerHeight;
      const scrollable = root.scrollHeight > window.innerHeight + 120;
      const atBottom = remaining <= 96;

      button.hidden = !scrollable;
      button.classList.toggle('is-up', atBottom);
      button.setAttribute('aria-label', atBottom ? 'Scroll to top' : 'Scroll to bottom');
      button.title = atBottom ? 'Scroll to top' : 'Scroll to bottom';
      button.dataset.direction = atBottom ? 'up' : 'down';
    };

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const goUp = button.dataset.direction === 'up';

      window.scrollTo({
        top: goUp ? 0 : document.documentElement.scrollHeight,
        behavior: reduceMotion ? 'auto' : 'smooth'
      });
    });

    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  }
</script>
