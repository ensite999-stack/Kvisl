---
import ScrollToBottom from './ScrollToBottom.astro';
---
<header class="site-header" id="site-header">
  <div class="container header-inner header-shell">
    <a class="header-logo" href="/" aria-label="Kvisl home" translate="no">
      <img src="/icon.svg" alt="" width="36" height="36" />
    </a>

    <div class="header-actions">
      <nav class="desktop-header-nav" aria-label="Primary">
        <a class="header-link" href="/archive">Archive</a>
        <a class="header-link" href="/subscribe">Subscribe</a>
      </nav>

      <a class="header-icon-link" href="/search" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m15.5 15.5 5 5"></path>
        </svg>
      </a>

      <ScrollToBottom />

      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="site-menu" data-site-menu hidden>
    <nav aria-label="Menu">
      <a href="/about">About</a>
      <a href="/subscribe">Subscribe</a>
      <a href="/archive">Archive</a>
      <a href="/donate">Donate</a>
    </nav>

    <div class="site-menu-appearance" aria-label="Appearance">
      <button type="button" data-menu-theme="light">Light</button>
      <button type="button" data-menu-theme="dark">Dark</button>
    </div>

    <a
      class="menu-instagram"
      href="https://www.instagram.com/hollis.jiang?stkn=MW1wNTVscXl5c3ozbw=="
      target="_blank"
      rel="me noopener noreferrer"
      aria-label="Instagram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.6" cy="6.7" r="1"></circle>
      </svg>
      <span>Instagram</span>
    </a>
  </div>
</header>

<script>
  const header = document.querySelector('#site-header');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const siteMenu = document.querySelector('[data-site-menu]');
  let lastY = window.scrollY;

  const closeMenu = () => {
    if (!(menuToggle instanceof HTMLButtonElement) || !(siteMenu instanceof HTMLElement)) return;
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Open menu');
    siteMenu.hidden = true;
    document.documentElement.classList.remove('menu-open');
  };

  menuToggle?.addEventListener('click', () => {
    if (!(menuToggle instanceof HTMLButtonElement) || !(siteMenu instanceof HTMLElement)) return;
    const open = menuToggle.getAttribute('aria-expanded') !== 'true';
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    siteMenu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  });

  siteMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  document.querySelectorAll('[data-menu-theme]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const theme = button.dataset.menuTheme;
      if (theme !== 'light' && theme !== 'dark') return;
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem('kvisl-theme', theme); } catch {}
      closeMenu();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const onScroll = () => {
    if (!(header instanceof HTMLElement)) return;
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 18);
    if (document.documentElement.classList.contains('menu-open')) return;
    if (Math.abs(y - lastY) > 8) {
      if (y > lastY && y > 120) header.classList.add('hidden');
      else header.classList.remove('hidden');
      lastY = y;
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
