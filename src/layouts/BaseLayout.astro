---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToBottom from '../components/ScrollToBottom.astro';
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  article?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image = '/icons/icon-512.png',
  article = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const absoluteImage = image ? new URL(image, Astro.site ?? Astro.url.origin).toString() : undefined;
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  slogan: site.tagline,
  url: (Astro.site ?? new URL(Astro.url.origin)).toString(),
  logo: new URL('/icons/icon-512.png', Astro.site ?? Astro.url.origin).toString(),
  description: site.description
};
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={site.color} />
    <meta name="description" content={description} />
    <meta name="application-name" content="Kvisl" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Kvisl" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Kvisl RSS" href="/rss.xml" />
    <meta property="og:site_name" content="Kvisl" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('kvisl-theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)}></script>
  </head>
  <body>
    <Header />
    <slot />
    <ScrollToBottom />
    <Footer />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
