NEXT_PUBLIC_SITE_URL=https://kvisl.com

# PostgreSQL-compatible database used for articles and newsletter subscribers.
DATABASE_URL=

# Editorial login at /admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob, used only for editorial image uploads. Connecting a public Blob
# Store in Vercel supplies BLOB_STORE_ID + rotating OIDC credentials. The static
# token remains a supported fallback for local development.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Resolve ordinary Pexels photo-page links and retrieve photographer credits.
# Keep this server-only; never rename it with a NEXT_PUBLIC_ prefix.
PEXELS_API_KEY=
